# Copy to .env and fill in. .env is gitignored — never commit it.
#
# NOTE: this file is sourced by scripts/build-android.sh, so QUOTE any value
# containing a space — NAME="Erika Mustermann", not NAME=Erika Mustermann.

# ---------------------------------------------------------------------------
# Android signing (scripts/build-android.sh)
# ---------------------------------------------------------------------------
# The build writes android/keystore.properties from these on every run, so the
# passwords live in exactly one place. Both that file and the .jks are
# gitignored.
#
# Create the upload keystore once:
#
#   keytool -genkeypair -v \
#     -keystore /home/stephan/.android-keys/quote-bingo.jks \
#     -storetype PKCS12 -keyalg RSA -keysize 4096 -validity 10000 \
#     -alias upload \
#     -dname "CN=Stephan, O=steppicrew, C=DE"
#   chmod 600 /home/stephan/.android-keys/quote-bingo.jks
#
# It asks for the store password, then the key password — pressing Enter at the
# second prompt reuses the store password, in which case set both variables
# below to the same value. `-validity 10000` (~27 years) matters because Play
# requires a key valid well past 2033.
#
# BACK THIS FILE UP OFFLINE. It is the *upload* key: if Play App Signing is
# enabled Google can reset a lost upload key, but without that safety net a
# lost key means the app can never be updated again.
ANDROID_KEYSTORE=/home/stephan/.android-keys/quote-bingo.jks
ANDROID_KEY_ALIAS=upload
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# ---------------------------------------------------------------------------
# Android application id
# ---------------------------------------------------------------------------
# Committed default: de.steppicrew.quotebingo (capacitor.config.json).
# Uncomment to override — e.g. to build a fork under a different identity.
#
# WARNING: the application id is permanent. Once a build is published under it,
# Play will not let you change it; a new id means a new listing, new reviews and
# a new install base. Changing it locally also breaks upgrades for anyone who
# sideloaded the old build.
#
# `yarn android:build` applies this to Gradle, strings.xml and the Java package.
#ANDROID_APP_ID=de.steppicrew.quotebingo

# ---------------------------------------------------------------------------
# Google Play publishing (scripts/play-publish.mjs)
# ---------------------------------------------------------------------------
# Absolute path to the JSON key of a Google Cloud service account that has
# access to this app in Play Console. One-time setup:
#
#  1. Google Cloud Console → create (or pick) a project.
#  2. APIs & Services → Library → enable "Google Play Android Developer API".
#  3. IAM & Admin → Service Accounts → Create service account.
#     Name it e.g. "play-publisher". No Google Cloud role is required.
#  4. On that account: Keys → Add key → Create new key → JSON. Save the file
#     somewhere private (NOT in this repo) and point the variable below at it.
#  5. Play Console → Users and permissions → Invite new user.
#     Enter the service account's email (…@….iam.gserviceaccount.com).
#     Grant it access to this app with the "Release manager" role — that covers
#     uploading bundles, editing the store listing and managing releases.
#  6. Accept the invitation (it applies immediately for service accounts) and
#     wait a few minutes for the permission to propagate.
#
# Verify without sending anything:  yarn play:publish --dry-run
PLAY_SERVICE_ACCOUNT_JSON=/home/stephan/.android-keys/play-service-account.json
