build-output/

# Launcher icons, splash and localised labels are generated by `yarn assets`,
# but they are COMMITTED: resource linking needs them, so leaving them out made
# `yarn android:build` hard-fail on any machine without ImageMagick 7. They are
# reproducible (`-strip`, no timestamp chunks), so a rerun on an unchanged master
# is a no-op in `git status` rather than 25 files of churn.

# Generated Play assets. The icon and feature graphics (`yarn assets` /
# `yarn feature-graphic`) are committed for the same reason as the launcher
# icons: reproducible, small, and needed by `yarn play:publish`.
#
# Screenshots stay ignored. `yarn screenshots` drives a real browser, and the
# win shot (02-bingo) is tapped live rather than seeded, so its confetti frame
# differs every run — committing 32M that re-churns on each rerun is not worth
# it. Run `yarn screenshots` before publishing listing images.
assets/screenshots/

# Exported per-language listing files (regenerated by `yarn store-listing`)
store-listing/*/

# Yarn (node-modules linker)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Privacy pages are generated by `yarn privacy`
public/privacy/
